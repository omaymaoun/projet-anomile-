{% extends 'base-back.html.twig' %}

{% block title %}Notes d'intervention{% endblock %}

{% block body %}

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}
{% endfor %}

<div class="container mt-5 d-flex justify-content-center">
    <h1 class="mb-4 text-primary w-100 text-center"><i class="bi bi-journal-text me-2"></i>Notes d'intervention</h1>
</div>

<div class="container d-flex justify-content-center">
    <div class="card shadow border-0 rounded-3 p-4" style="width: 100%; min-height: 600px; background-color: #fff;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="noteTable" class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th scope="col">Contenu</th>
                            <th scope="col"><i class="bi bi-calendar-event"></i> Date</th>
                            <th scope="col"><i class="bi bi-person"></i> Technicien</th>
                            <th scope="col"><i class="bi bi-image"></i> Photo</th>
                            <th scope="col" style="width: 15%"><i class="bi bi-gear"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for note in notes %}
                            <tr>
                                <td>
                                    {% if note.contenu|length > 80 %}
                                        <span class="text-truncate d-inline-block" style="max-width: 250px;" title="{{ note.contenu }}">
                                            {{ note.contenu|slice(0, 80) ~ '...' }}
                                        </span>
                                        <span class="badge bg-warning text-dark">Long</span>
                                    {% else %}
                                        {{ note.contenu }}
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">
                                        <i class="bi bi-clock me-1"></i>{{ note.dateIntervention|date('d/m/Y H:i') }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    {% if note.technicien %}
                                        <span class="badge bg-light text-dark border technicien-name">
                                            {{ note.technicien.prenom }} {{ note.technicien.nom }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">Aucun</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% if note.photo %}
                                        <img src="{{ asset('uploads/photos/' ~ note.photo) }}" alt="Photo" width="100" class="img-thumbnail rounded-2 shadow-sm border">
                                    {% else %}
                                        <span class="badge bg-secondary"><i class="bi bi-image"></i> Aucune</span>
                                    {% endif %}
                                </td>
                                <td class="text-center" style="min-width: 150px;">
                                    <form method="post" action="{{ path('note_delete', { id: note.id }) }}" onsubmit="return confirm('Confirmer la suppression de cette note ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ note.id) }}">
                                        <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="bi bi-exclamation-circle"></i> Aucune note trouvée.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{% block javascripts %}
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new DataTable('#noteTable');
        });
    </script>
{% endblock %}

{% endblock %}
