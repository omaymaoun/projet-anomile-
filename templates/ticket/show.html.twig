{% extends 'base.html.twig' %}

{% block title %}Détail du Ticket{% endblock %}

{% block body %}
<section class="container my-5">
    <h1 class="mb-4">📄 Détail du Ticket</h1>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-bordered table-hover">
                <tbody>
                    <tr>
                        <th style="width: 200px;">ID</th>
                        <td>{{ ticket.id }}</td>
                    </tr>
                    <tr>
                        <th>Titre</th>
                        <td>{{ ticket.titre }}</td>
                    </tr>
                    <tr>
                        <th>Description</th>
                        <td>{{ ticket.description }}</td>
                    </tr>
                    <tr>
                        <th>Photo</th>
                        <td>
                            {% if ticket.photo %}
                                <img src="{{ asset('uploads/photos/' ~ ticket.photo) }}" alt="photo ticket" class="img-fluid rounded shadow-sm" style="max-width: 150px;">
                            {% else %}
                                <span class="text-muted">Aucune photo disponible</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="mt-4 d-flex justify-content-between">
                <a href="{{ path('app_ticket_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>

                <div>
                    <a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}" class="btn btn-primary me-2">
                        <i class="bi bi-pencil-square"></i> Modifier
                    </a>
                    {{ include('ticket/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
