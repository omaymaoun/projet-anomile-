{% extends 'base-back.html.twig' %}

{% block title %}Espace Employé - Tickets{% endblock %}

{% block body %}
<section id="tickets-employe">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header">
                    <h4 class="card-title">📋 Liste des Tickets Signalés</h4>
                </div>
                <div class="card-content collapse show">
                    <div class="card-body card-dashboard">

                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}

                        <p class="card-text text-muted">
                            Utilisez les flèches du clavier ou cliquez dans les cellules pour naviguer comme dans Excel.
                        </p>

                        <div class="table-responsive">
                            <!-- Conteneur pour show entries et recherche -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <label>
                                        Afficher
                                        <select id="entriesLength" class="form-select form-select-sm d-inline-block w-auto">
                                            <option value="10" selected>10</option>
                                            <option value="25">25</option>
                                            <option value="50">50</option>
                                            <option value="-1">Tous</option>
                                        </select>
                                        entrées
                                    </label>
                                </div>
                                <div>
                                    <label>
                                        Rechercher :
                                        <input type="search" id="tableSearch" class="form-control form-control-sm d-inline-block" style="width: 200px;">
                                    </label>
                                </div>
                            </div>

                            <table class="table table-striped table-bordered dataex-key-basic w-100">
                                <thead class="table-light text-center text-uppercase small">
                                    <tr>
                                        <th>Titre</th>
                                        <th>Description</th>
                                        <th>Localisation</th>
                                        <th>Photo</th>
                                        <th>Date Création</th>
                                        <th>Date Fin</th> 
                                         <th>Catégorie</th>
                                         <th>Criticité</th> 
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for ticket in tickets %}
                                        <tr>
                                            <td>{{ ticket.titre }}</td>
                                            <td>{{ ticket.description|length > 80 ? ticket.description|slice(0, 80) ~ '...' : ticket.description }}</td>
                                            <td>{{ ticket.localisation }}</td>
                                            <td class="text-center">
                                                {% if ticket.photo %}
                                                    <a href="{{ asset('uploads/photos/' ~ ticket.photo) }}" target="_blank">
                                                        <img src="{{ asset('uploads/photos/' ~ ticket.photo) }}" alt="photo" class="rounded shadow-sm" style="width: 70px; cursor: zoom-in;">
                                                    </a>
                                                {% else %}
                                                    <span class="text-muted">Aucune</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">{{ ticket.date ? ticket.date|date('d/m/Y H:i') : '—' }}</td>
                                            <td class="text-center">{{ ticket.dateFin ? ticket.dateFin|date('d/m/Y H:i') : '—' }}</td> <!-- Nouvelle colonne -->
                                             {# Colonne Catégorie #}
                                            <td class="text-center">
                                                {% if ticket.categorie == 'Hard' %}
                                                    <span class="badge bg-danger">Hard</span>
                                                {% elseif ticket.categorie == 'Soft' %}
                                                    <span class="badge bg-primary">Soft</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">—</span>
                                                {% endif %}
                                            </td>

                                                                                    <td class="text-center">
                                                {% set crit = ticket.criticite|trim|capitalize %}
                                                {% if crit == 'Critique' %}
                                                    <span class="badge bg-danger">Critique</span>
                                                {% elseif crit == 'Majeure' %}
                                                    <span class="badge bg-warning text-dark">Majeure</span>
                                                {% elseif crit == 'Mineure' %}
                                                    <span class="badge bg-success">Mineure</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">—</span>
                                                {% endif %}
                                            </td>



                                            
                                                                               


                                            <td class="text-center">
                                                {% if ticket.statut == 'en attente' %}
                                                    <span class="badge bg-warning text-dark">En attente</span>
                                                {% elseif ticket.statut == 'en cours' %}
                                                    <span class="badge bg-primary">En cours</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Terminé</span>
                                                {% endif %}
                                            </td>
                                          <td class="text-center">
    <div class="btn-group d-flex justify-content-center gap-1" role="group" aria-label="Actions">
        <a href="{{ path('app_technicien_index', {'ticketId': ticket.id}) }}" class="btn btn-sm btn-outline-primary flex-fill" style="min-width: 130px;">
            <i class="bi bi-tools me-1"></i> Assigner un technicien
        </a>

        

        <a href="{{ path('ticket_modifier_criticite', { id: ticket.id }) }}" class="btn btn-sm btn-warning flex-fill" style="min-width: 140px;">
            <i class="bi bi-pencil-square me-1"></i> Modifier criticité
        </a>


        <form method="post" action="{{ path('ticket_delete', { id: ticket.id }) }}" onsubmit="return confirm('Confirmer la suppression ?');" style="display: inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ticket.id) }}">
            <button type="submit" class="btn btn-sm btn-outline-danger flex-fill" style="min-width: 100px;">
                <i class="bi bi-trash3 me-1"></i> Supprimer
            </button>
        </form>
    </div>
</td>

                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-4">Aucun ticket trouvé.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center mt-3">
                                <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                                    <a class="page-link" href="{% if currentPage > 1 %}{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': currentPage - 1})) }}{% else %}#{% endif %}">
                                        Précédent
                                    </a>
                                </li>
                                {% for i in 1..totalPages %}
                                    <li class="page-item {% if i == currentPage %}active{% endif %}">
                                        <a class="page-link" href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': i})) }}">{{ i }}</a>
                                    </li>
                                {% endfor %}
                                <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                                    <a class="page-link" href="{% if currentPage < totalPages %}{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page': currentPage + 1})) }}{% else %}#{% endif %}">
                                        Suivant
                                    </a>
                                </li>
                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/keytable/2.9.0/js/dataTables.keyTable.min.js"></script>
    <script>
        $(document).ready(function () {
            var table = $('.dataex-key-basic').DataTable({
                keys: true,
                scrollX: true,
                searching: false,
                lengthChange: false,
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                }
            });

            // Recherche manuelle
            $('#tableSearch').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Gestion du select "afficher X entrées"
            $('#entriesLength').on('change', function () {
                var val = $(this).val();
                table.page.len(val).draw();
            });
        });
    </script>
{% endblock %}
