<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <title>{% block title %}Dashboard - Stack Admin Template{% endblock %}</title>
    <link rel="shortcut icon" type="image/x-icon" href="{{ asset('app-assets/images/ico/favicon.ico') }}">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,300i,400,400i,500,500i%7COpen+Sans:300,300i,400,400i,600,600i,700,700i" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Vendor CSS -->
    <link rel="stylesheet" type="text/css" href="{{ asset('app-assets/vendors/css/vendors.min.css') }}">

    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="{{ asset('app-assets/css/bootstrap.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('app-assets/css/bootstrap-extended.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('app-assets/css/colors.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('app-assets/css/components.css') }}">

    <!-- Page CSS -->
    <link rel="stylesheet" type="text/css" href="{{ asset('app-assets/css/core/menu/menu-types/vertical-menu-modern.css') }}">

    <!-- DataTables CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
</head>

<body class="vertical-layout vertical-menu-modern 2-columns fixed-navbar" data-open="click" data-menu="vertical-menu-modern" data-col="2-columns">

    <!-- Header -->
    <nav class="header-navbar navbar-expand-lg navbar navbar-with-menu fixed-top navbar-semi-dark navbar-shadow">
        <div class="navbar-wrapper">
            <div class="navbar-header">
                <ul class="nav navbar-nav flex-row">
                    <li class="nav-item mobile-menu d-lg-none mr-auto">
                        <a class="nav-link nav-menu-main menu-toggle hidden-xs" href="#"><i class="ft-menu font-large-1"></i></a>
                    </li>
                    <li class="nav-item mr-auto">
                        <a class="navbar-brand" href="#">
                            <h2 class="brand-text">Stack</h2>
                        </a>
                    </li>
                </ul>
            </div>
            
            <!-- Partie droite avec le lien de login/déconnexion -->
            <div class="navbar-container content">
                <div class="collapse navbar-collapse" id="navbar-mobile">
                    <ul class="nav navbar-nav float-right">
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}">
                                    <i class="ft-power"></i> Déconnexion
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">
                                    <i class="ft-user"></i> Connexion
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Menu -->
    <div class="main-menu menu-fixed menu-dark menu-accordion menu-shadow" data-scroll-to-active="true">
        <div class="main-menu-content">
            <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">
                <li class="navigation-header"><span>General</span></li>

                <li class="nav-item">
                    <a href="#"><i class="ft-home"></i><span class="menu-title">Dashboard</span></a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_technicien_index') }}"><i class="ft-users"></i><span class="menu-title">Liste des Techniciens</span></a>
                </li>

                <li class="nav-item">
                    <a href="{{ path('app_ticket_index') }}"><i class="ft-list"></i><span class="menu-title">Liste des pannes</span></a>
                </li>

                <li class="nav-item {% if app.request.attributes.get('_route') == 'app_ticket_techniciens' %}active{% endif %}">
                    <a href="{{ path('app_ticket_techniciens') }}">
                        <i class="ft-link"></i>
                        <span class="menu-title">Techniciens & Pannes</span>
                    </a>
                </li>

                <li class="nav-item {% if app.request.attributes.get('_route') == 'note_intervention_index' %}active{% endif %}">
                    <a href="{{ path('note_intervention_index') }}">
                        <i class="bi bi-journal-text"></i>
                        <span class="menu-title">Voir Notes</span>
                    </a>
                </li>

                <li class="nav-item {% if app.request.attributes.get('_route') == 'app_ticket_history' %}active{% endif %}">
    <a href="{{ path('app_ticket_history') }}">
        <i class="bi bi-clock-history"></i>
        <span class="menu-title">Historique des Tickets</span>
    </a>
</li>


                
            </ul>
        </div>
    </div>

    <!-- BEGIN: Content -->
    <div class="app-content content">
        <div class="content-wrapper">
            <div class="content-header row">
                <div class="content-header-left col-md-6 col-12 mb-2">
                    <h3 class="content-header-title mb-0">{% block page_title %}Dashboard{% endblock %}</h3>
                </div>

                <!-- Barre de recherche -->
                <div class="content-header-right col-md-6 col-12">
                    <div class="input-group">
                        <input type="text" id="searchInput" class="form-control" placeholder="Rechercher...">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                    </div>
                </div>
            </div>

            <div class="content-body">
                {% block body %}
                <!-- Contenu principal -->
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped" id="dataTable">
                                <thead>
                                    <tr>
                                        <th>Titre</th>
                                        <th>Description</th>
                                        <th>Technicien</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for ticket in tickets %}
                                        <tr>
                                            <td>{{ ticket.titre }}</td>
                                            <td>{{ ticket.description|length > 80 ? ticket.description|slice(0, 80) ~ '...' : ticket.description }}</td>
                                            <td>
                                                {% if ticket.technicien %}
                                                    {{ ticket.technicien.nom }} {{ ticket.technicien.prenom }}
                                                {% else %}
                                                    <em class="text-muted">Non assigné</em>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if ticket.statut == 'en attente' %}
                                                    <span class="badge bg-warning">En attente</span>
                                                {% elseif ticket.statut == 'en cours' %}
                                                    <span class="badge bg-primary">En cours</span>
                                                {% else %}
                                                    <span class="badge bg-success">Terminé</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="{{ path('ticket_show', {'id': ticket.id}) }}" class="btn btn-sm btn-outline-primary">
                                                        <i class="bi bi-eye"></i> Voir
                                                    </a>
                                                    <a href="{{ path('ticket_edit', {'id': ticket.id}) }}" class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-pencil"></i> Modifier
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">Aucun ticket trouvé.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                {% endblock %}
            </div>
        </div>
    </div>
    <!-- END: Content -->

    <!-- Vendor JS -->
    <script src="{{ asset('app-assets/vendors/js/vendors.min.js') }}"></script>

    <!-- Theme JS -->
    <script src="{{ asset('app-assets/js/core/app-menu.js') }}"></script>
    <script src="{{ asset('app-assets/js/core/app.js') }}"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- Script pour la recherche avec DataTables -->
    <script>
        $(document).ready(function() {
            // Initialisation de DataTable
            var table = $('#dataTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json',
                    search: "_INPUT_",
                    searchPlaceholder: "Rechercher...",
                },
                dom: '<"top"f>rt<"bottom"lip><"clear">',
                responsive: true
            });

            // Lier la recherche dans le champ de recherche personnalisé à DataTable
            $('#searchInput').keyup(function() {
                table.search($(this).val()).draw();
            });
        });
    </script>

</body>
</html>